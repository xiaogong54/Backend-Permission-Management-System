# ==========================================================================
#  mall-admin · Git 忽略规则
#  原则：凡是「能由源码重新生成的」和「含密钥的」，一律不入库。
# ==========================================================================

# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 构建产物（可由源码重新生成） ----------
dist/
build/
lib/
*.tsbuildinfo
.output/
.vite/

# ---------- 环境变量 ----------
# 绝不提交真实 .env：里面是数据库密码、JWT 密钥、Redis 密码
# 只提交 .env.example 作为「需要哪些变量」的说明
.env
.env.local
.env.*.local
!.env.example

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---------- 本地数据库文件 ----------
*.sqlite
*.sqlite3
*.db

# ---------- 本地上传目录（文件上传功能的落盘位置） ----------
uploads/
apps/server/uploads/

# ---------- 测试覆盖率 ----------
coverage/
.nyc_output/

# ---------- 编辑器 ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 工具缓存 ----------
.eslintcache
.cache/
.turbo/
