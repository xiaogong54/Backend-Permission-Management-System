{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "auto",
  "vueIndentScriptAndStyle": false,
  "overrides": [
    {
      "files": ["*.md", "*.yml", "*.yaml"],
      "options": { "printWidth": 120, "singleQuote": false }
    }
  ]
}
