# ============================================================================
#  后端环境变量模板
#  用法：复制成 .env 再按实际情况改。.env 已被 .gitignore 排除，不会入库。
#    Copy-Item .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
#  数据库
#  格式：mysql://用户名:密码@主机:端口/库名
# ---------------------------------------------------------------------------

# 迁移用（prisma7.config.ts 读取它）
DATABASE_URL="mysql://root:root@127.0.0.1:3306/mall_admin"

# 运行时用（Prisma 7 的 driver adapter 不接受连接串，要拆开的字段）
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=mall_admin
DATABASE_POOL_SIZE=10

# 若改用仓库里的 docker-compose 起数据库，端口要换成 3307
# （宿主机 3306 通常已被本机安装的 MySQL 占用）
# DATABASE_URL="mysql://root:root@127.0.0.1:3307/mall_admin"
# DATABASE_PORT=3307

# ---------------------------------------------------------------------------
#  Redis（验证码、Token 黑名单、看板缓存）—— auth 模块实现后才用得上
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ---------------------------------------------------------------------------
#  JWT —— auth 模块实现后才用得上
#  ⚠️ 生产环境务必换成足够长的随机串，绝不能用这里的示例值
# ---------------------------------------------------------------------------
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
#  应用
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# 生产环境务必设为 false，避免接口文档暴露在外网
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
#  文件上传
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5

# ---------------------------------------------------------------------------
#  操作日志：请求参数超过这个长度就截断，避免 JSON 字段被撑爆
# ---------------------------------------------------------------------------
LOG_PARAM_MAX_LENGTH=4096
