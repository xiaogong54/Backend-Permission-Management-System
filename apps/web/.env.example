# ============================================================================
#  前端环境变量模板
#  用法：复制成 .env.development（或 .env.production）再按实际情况改。
#
#  注意：只有 VITE_ 前缀的变量会被注入到客户端代码里（Vite 的硬规则），
#  所以这里出现的任何值都是公开的，绝不能放密钥。
# ============================================================================

VITE_APP_TITLE=mall-admin 商家管理端

# 前端请求前缀。保持相对路径，走 vite.config.ts 里的 proxy
VITE_API_BASE_URL=/api/v1

# 开发代理目标（后端地址）
VITE_API_TARGET=http://localhost:3000

# ---------------------------------------------------------------------------
#  开发期临时开关：跳过登录校验
#  后端 auth 模块（登录 / 验证码 / JWT）尚未实现，打开它才能浏览页面。
#
#  代码里用 import.meta.env.DEV 包了一层，生产构建时该常量是编译期 false，
#  整段判断会被 tree-shaking 掉，生产包里不存在这个后门。
#  auth 模块完成后请改回 false 或直接删掉这一行。
# ---------------------------------------------------------------------------
VITE_DEV_BYPASS_AUTH=true
