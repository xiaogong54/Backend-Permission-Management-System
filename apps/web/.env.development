# ============================================================================
#  前端开发环境变量
#  只有 VITE_ 前缀的变量会被注入到客户端代码里（Vite 的硬规则），
#  所以千万不要把数据库密码之类的写在这里。
# ============================================================================

VITE_APP_TITLE=mall-admin 商家管理端

# 前端请求的前缀。保持相对路径，走 vite.config.ts 里的 proxy
VITE_API_BASE_URL=/api/v1

# 开发代理的目标（后端地址），改了后端端口只需要改这一处
VITE_API_TARGET=http://localhost:3000

# ---------------------------------------------------------------------------
#  开发期临时开关：跳过登录校验
#  后端的 auth 模块（登录 / 验证码 / JWT）尚未实现，打开它才能浏览页面。
#
#  安全性说明：代码里用 import.meta.env.DEV 包了一层，
#  生产构建时它是编译期常量 false，整段判断会被 tree-shaking 掉，
#  所以生产包里不存在这个后门。auth 模块做完后请把它改回 false。
# ---------------------------------------------------------------------------
VITE_DEV_BYPASS_AUTH=true
