# ============================================================================
#  前端开发环境变量
#  只有 VITE_ 前缀的变量会被注入到客户端代码里（Vite 的硬规则），
#  所以千万不要把数据库密码之类的写在这里。
# ============================================================================

VITE_APP_TITLE=mall-admin 商家管理端

# 前端请求的前缀。保持相对路径，走 vite.config.ts 里的 proxy
VITE_API_BASE_URL=/api/v1

# 开发代理的目标（后端地址），改了后端端口只需要改这一处
VITE_API_TARGET=http://localhost:3000

# ---------------------------------------------------------------------------
#  关于 VITE_DEV_BYPASS_AUTH（已移除）
#
#  这个"跳过登录校验"的开发开关原先存在于此，后端的 auth 模块实现后已经删掉。
#  删除理由：一个能关掉整套权限的开关，留着就迟早会被误用 ——
#  比如某次构建把 .env.development 的内容带进产物，权限体系就成了摆设，
#  而且从界面上完全看不出来。
#
#  现在需要临时进系统，就用真实账号登录，不再留第二条路。
# ---------------------------------------------------------------------------
